---
import SectionTitle from '@/components/ui/SectionTitle.astro';
import ProjectCard from '@/components/ui/ProjectCard.astro';

// Imágenes
import cover10minds from '@/assets/images/cover-10minds.webp';
import coverEconomixHub from '@/assets/images/cover-economixhub.webp';
import coverTsAura from '@/assets/images/cover-tsaura.webp';
import coverLMD from '@/assets/images/cover-lmd.webp';
import coverMinos from '@/assets/images/cover-minos.webp';
import coverMoviker from '@/assets/images/cover-moviker.webp';

const projects = [
  {
    title: '10Minds',
    description:
      'Redesigned e-learning platform to expand its reach and enhance the learning experience',
    image: cover10minds.src,
    tags: ['EdTech', 'Redesign'],
    href: 'https://www.behance.net/gallery/241947109/Harold-Portfolio',
    bg_personalized: 'bg-linear-to-br from-sky-500 via-sky-600 to-sky-700',
  },
  {
    title: 'EconomixHub',
    description: 'Platform that teaches economics and finance through interactive simulators',
    image: coverEconomixHub.src,
    tags: ['Economics', 'Simulations'],
    href: 'https://www.behance.net/gallery/241947109/Harold-Portfolio',
    bg_personalized: 'bg-linear-to-br from-green-500 via-green-600 to-green-700',
  },
  {
    title: 'TS Aura',
    description:
      'Web platform for designing acoustic enclosures with 3D simulation and visualization',
    image: coverTsAura.src,
    tags: ['Tools ', 'Audio Solutions'],
    href: 'https://www.behance.net/gallery/241947109/Harold-Portfolio',
    bg_personalized: 'bg-linear-to-br from-blue-500 via-blue-600 to-blue-700',
  },
  {
    title: 'La Movida Disyuntiva',
    description: 'Platform for managing podcast episodes, content, and publications',
    image: coverLMD.src,
    tags: ['Podcast', 'Branding'],
    href: 'https://www.behance.net/gallery/241947109/Harold-Portfolio',
    bg_personalized: 'bg-linear-to-br from-violet-500 via-violet-600 to-violet-700',
  },
  {
    title: 'Minos',
    description: 'System for managing political contacts and events via WhatsApp Business API',
    image: coverMinos.src,
    tags: ['Events ', 'Politics'],
    href: 'https://www.behance.net/gallery/241947109/Harold-Portfolio',
    bg_personalized: 'bg-linear-to-br from-cyan-500 via-cyan-600 to-cyan-700',
  },
  {
    title: 'Moviker',
    description: 'Specialized online store for selling sneakers and sportswear',
    image: coverMoviker.src,
    tags: ['E-commerce', 'Education'],
    href: 'https://www.behance.net/gallery/241947109/Harold-Portfolio',
    bg_personalized: 'bg-linear-to-br from-rose-500 via-rose-600 to-rose-700',
  },
];
---

<section id="projects" class="bg-surface border-border scroll-mt-24 rounded-3xl border p-6 md:p-14">
  <div class="mb-8 flex flex-col items-center text-center">
    <SectionTitle>Latest Projects</SectionTitle>
    <p class="text-secondary mx-auto mt-2 max-w-3xl text-lg leading-relaxed">
      These are some of the projects that reflect my approach to UX/UI and product design — from
      research all the way to the final solution.
    </p>
    <p class="text-accent mt-2 text-lg font-semibold">
      Each project includes process, design decisions, and key learnings
    </p>
  </div>

  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      projects.map((project, index) => (
        <ProjectCard
          {...project}
          data-aos="fade-up"
          data-aos-delay={index * 150}
          data-aos-offset="0"
        />
      ))
    }
  </div>
</section>
