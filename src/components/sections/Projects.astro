---
import SectionTitle from '@/components/ui/SectionTitle.astro';
import ProjectCard from '@/components/ui/ProjectCard.astro';

// Imágenes
import cover10minds from '@/assets/images/cover-10minds.webp';
import coverEconomixHub from '@/assets/images/cover-economixhub.webp';
import coverTsAura from '@/assets/images/cover-tsaura.webp';
import coverLMD from '@/assets/images/cover-lmd.webp';
import coverMinos from '@/assets/images/cover-minos.webp';
import coverMoviker from '@/assets/images/cover-moviker.webp';

const projects = [
  {
    title: '10Minds',
    description:
      'Plataforma e-learning rediseñada para expandir su alcance y mejorar la experiencia de aprendizaje',
    image: cover10minds.src,
    tags: ['EdTech', 'Rediseño'],
    href: 'https://www.behance.net/gallery/241947109/Harold-Portfolio',
    bg_personalized: 'bg-linear-to-br from-sky-500 via-sky-600 to-sky-700',
  },
  {
    title: 'EconomixHub',
    description:
      'Plataforma educativa que enseña economía y finanzas mediante simuladores interactivos',
    image: coverEconomixHub.src,
    tags: ['Economía', 'Simuladores'],
    href: 'https://www.behance.net/gallery/241947109/Harold-Portfolio',
    bg_personalized: 'bg-linear-to-br from-green-500 via-green-600 to-green-700',
  },
  {
    title: 'TS Aura',
    description: 'Plataforma web para diseñar cajas acústicas con simulación y visualización 3D',
    image: coverTsAura.src,
    tags: ['SaaS', 'Cajas Acústicas'],
    href: 'https://www.behance.net/gallery/241947109/Harold-Portfolio',
    bg_personalized: 'bg-linear-to-br from-blue-500 via-blue-600 to-blue-700',
  },
  {
    title: 'La Movida Disyuntiva',
    description: 'Plataforma para gestionar episodios, contenidos y publicaciones de podcasts',
    image: coverLMD.src,
    tags: ['Podcast', 'Gestión'],
    href: 'https://www.behance.net/gallery/241947109/Harold-Portfolio',
    bg_personalized: 'bg-linear-to-br from-violet-500 via-violet-600 to-violet-700',
  },
  {
    title: 'Minos',
    description:
      'Sistema para la gestión de contactos y eventos políticos con Whatsapp Business API',
    image: coverMinos.src,
    tags: ['Eventos', 'Política'],
    href: 'https://www.behance.net/gallery/241947109/Harold-Portfolio',
    bg_personalized: 'bg-linear-to-br from-cyan-500 via-cyan-600 to-cyan-700',
  },
  {
    title: 'Moviker',
    description: 'Tienda online especializada en la venta de zapatillas y ropa deportiva',
    image: coverMoviker.src,
    tags: ['Ecommerce', 'Educativo'],
    href: 'https://www.behance.net/gallery/241947109/Harold-Portfolio',
    bg_personalized: 'bg-linear-to-br from-rose-500 via-rose-600 to-rose-700',
  },
];
---

<section id="projects" class="bg-surface border-border scroll-mt-24 rounded-3xl border p-6 md:p-14">
  <div class="mb-8 flex flex-col items-center text-center">
    <SectionTitle>Últimos proyectos</SectionTitle>
    <p class="text-secondary mx-auto mt-2 max-w-3xl text-lg leading-relaxed">
      Estos son algunos de los proyectos que representan mi enfoque en UX/UI y diseño de producto,
      desde la investigación hasta la solución final
    </p>
    <p class="text-accent mt-2 text-lg font-semibold">
      Cada proyecto incluye proceso, decisiones de diseño y aprendizajes
    </p>
  </div>

  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      projects.map((project, index) => (
        <ProjectCard
          {...project}
          data-aos="fade-up"
          data-aos-delay={index * 150}
          data-aos-offset="0"
        />
      ))
    }
  </div>
</section>
