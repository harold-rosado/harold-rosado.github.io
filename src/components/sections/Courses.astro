---
import SectionTitle from '../ui/SectionTitle.astro';
import Button from '@/components/ui/Button.astro';

import { Icon } from 'astro-icon/components';
import bootstrapSvgUrl from '@/icons/illustrations/bootstrap.svg?url';

const courses = [
  {
    title: 'Bootstrap from Scratch',
    description:
      'Build a complete web project, from the fundamentals to modern and responsive layouts.',
    illustration: 'illustrations/bootstrap',
    url: 'https://www.youtube.com/watch?v=gWan3LptzgM',
    label: 'Learn Now',
    status: 'available',
  },
  {
    title: 'Introduction to Git',
    description:
      'Master version control and work in an organized way like a professional developer.',
    illustration: 'illustrations/git',
    url: '#',
    label: 'Coming Soon',
    status: 'coming-soon',
  },
  {
    title: 'Prototyping in Figma',
    description:
      'Design intuitive experiences and communicate your ideas clearly and effectively using Figma.',
    illustration: 'illustrations/figma',
    url: '#',
    label: 'Coming Soon',
    status: 'coming-soon',
  },
];
---

<section
  id="courses"
  class="bg-surface border-border/50 scroll-mt-24 rounded-3xl border p-6 md:p-14"
>
  <div class="mb-8 flex flex-col items-center text-center" data-aos="fade-up">
    <SectionTitle>Courses & Workshops</SectionTitle>
    <p class="text-secondary mt-2 text-lg leading-relaxed text-balance">
      Throughout my career, I've had the opportunity to share my knowledge through courses and
      workshops focused on <span class="text-primary font-medium"
        >UX/UI and software development</span
      >.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      courses.map((course, index) => (
        <article
          class="group border-border bg-elevated/30 flex flex-col rounded-2xl border p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-indigo-500/5"
          data-aos="fade-up"
          data-aos-delay={index * 150}
        >
          <div class="bg-surface border-border group-hover:border-accent mb-4 flex size-18 items-center justify-center rounded-2xl border transition-colors">
            {index === 0 ? (
              <img
                src={bootstrapSvgUrl}
                alt={courses[0].title}
                class="size-12 object-contain transition-transform group-hover:scale-110"
                loading="lazy"
              />
            ) : (
              <Icon
                name={course.illustration}
                class="size-12 transition-transform group-hover:scale-110"
              />
            )}
          </div>

          <h5 class="text-primary mb-2 text-xl font-bold">{course.title}</h5>

          <p class="text-secondary mb-6 line-clamp-3 flex-1 leading-relaxed">
            {course.description}
          </p>

          <div class="mt-auto flex flex-col md:items-start">
            {course.status === 'available' ? (
              <a href={course.url} target="_blank" rel="noopener noreferrer">
                <Button variant="filled" class="w-full md:w-auto">
                  {course.label}
                </Button>
              </a>
            ) : (
              <Button variant="outlined" class="w-full md:w-auto" disabled>
                {course.label}
              </Button>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
