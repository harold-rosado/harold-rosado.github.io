---
import SectionTitle from '@/components/ui/SectionTitle.astro';
import Button from '@/components/ui/Button.astro';
import FormField from '@/components/ui/FormField.astro';
import FormTextArea from '@/components/ui/FormTextArea.astro';

import backgroundImage from '@/assets/images/background-cta.webp';

import { Icon } from 'astro-icon/components';
---

<section
  id="contact"
  class="grid scroll-mt-24 grid-cols-1 items-stretch gap-6 overflow-hidden lg:grid-cols-2 lg:gap-12"
>
  <div
    class="group relative flex min-h-87.5 items-center justify-center overflow-hidden rounded-3xl p-8 md:p-12"
    data-aos="fade-right"
  >
    <div
      class="absolute inset-0 z-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110"
      style={`background-image: url(${backgroundImage.src});`}
    >
    </div>
    <div class="absolute inset-0 z-10 bg-indigo-500/60"></div>
    <!-- Contenido  -->
    <div class="relative z-20 flex flex-col items-center text-center">
      <div
        class="mb-6 flex size-20 items-center justify-center rounded-2xl border border-white/20 bg-white/10 shadow-2xl"
      >
        <Icon name="lucide:message-circle-more" class="size-10 text-white" />
      </div>

      <h2 class="mb-4 text-3xl font-bold text-white md:text-4xl">
        Let's Talk About Your Next Project?
      </h2>
      <p class="max-w-md text-lg leading-relaxed text-white">
        Whether you have a clear idea or are still exploring, I'd love to hear from you and see how
        we can collaborate.
      </p>
    </div>
  </div>

  <div class="bg-surface border-border/50 rounded-3xl border p-4 md:p-8" data-aos="fade-left">
    <div class="mb-6">
      <SectionTitle>Contact Me</SectionTitle>
      <p class="text-secondary mt-4">
        Tell me a little more about what you need and I'll be in touch with you soon.
      </p>
    </div>

    <form
      role="form"
      aria-label="Formulario de contacto"
      class="flex flex-col gap-4"
      action="https://formspree.io/f/xykkkqbg"
      method="POST"
    >
      <input type="text" name="_gotcha" style="display:none" />
      <FormField label="Full Name" name="name" placeholder="Jhon Doe" autocomplete="name" />
      <FormField
        label="Email"
        type="email"
        name="email"
        placeholder="jhondoe@gmail.com"
        autocomplete="email"
      />
      <FormField label="Subject" name="subject" placeholder="What can I help you with?" />
      <FormTextArea
        label="Message"
        name="message"
        placeholder="Tell me more about your project..."
      />
      <div>
        <Button type="submit" fullWidth class="md:w-auto">Send Message</Button>
      </div>
    </form>
  </div>
</section>
